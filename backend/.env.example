# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (Render = 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=1

# ---------- Database ----------
# Local:  mongodb://127.0.0.1:27017/food-club
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food-club?retryWrites=true&w=majority
#MONGODB_URI=mongodb://127.0.0.1:27017/food-club

# ---------- Authentication ----------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---------- CORS ----------
# Frontend origin(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173

# ---------- First super admin ----------
# Created automatically on startup if no user with this email exists yet.
# After the first successful start you can remove SUPERADMIN_PASSWORD from the environment.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
